<?xml version="1.0" encoding="utf-8"?>
<!--
  MiCloud-A16 privileged permission allowlist.

  com.miui.cloudbackup: stock block, copied verbatim from the CN ROM's
  product/etc/permissions/privapp-permissions-product.xml (OS3.0.306.0.WNRCNXM).

  com.xiaomi.account / com.miui.cloudservice / com.miui.micloudsync: on HyperOS these
  live in product/app and get their framework permissions by matching the platform
  certificate (c9009d01...). AlphaDroid's platform key is different, so the module
  installs them as priv-apps instead and allowlists the signature|privileged
  permissions they request that are defined by "android" on the device. Nothing
  else is listed.

  Not listed, because they are inert here:
  - pure-signature framework permissions (only the platform key can hold them);
  - privileged permissions defined by other packages (com.miui.system, com.miui.home,
    com.android.providers.downloads): PackageManager only enforces this allowlist for
    permissions declared by the platform;
  - MIUI permissions that AlphaDroid does not define (see notes/permissions-audit.tsv).
-->
<permissions>
    <privapp-permissions package="com.miui.cloudbackup">
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.FORCE_STOP_PACKAGES" />
        <permission name="android.permission.DELETE_PACKAGES" />
        <permission name="android.permission.INSTALL_PACKAGES" />
        <permission name="android.permission.READ_PHONE_STATE" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_APN_SETTINGS" />
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        <permission name="android.permission.UPDATE_DEVICE_STATS" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.CONNECTIVITY_INTERNAL" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.ACCESS_MTP" />
        <permission name="android.permission.SCHEDULE_EXACT_ALARM" />
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    </privapp-permissions>

    <privapp-permissions package="com.xiaomi.account">
        <permission name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" />
        <permission name="android.permission.GET_ACCOUNTS_PRIVILEGED" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.LOCAL_MAC_ADDRESS" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>

    <privapp-permissions package="com.miui.cloudservice">
        <permission name="android.permission.ACCESS_CACHE_FILESYSTEM" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.UPDATE_APP_OPS_STATS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>

    <privapp-permissions package="com.miui.micloudsync">
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
